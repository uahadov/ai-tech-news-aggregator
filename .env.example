# ===== TELEGRAM =====
# @BotFather-dan al
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID-ni almaq üçün @userinfobot-a yaz
TELEGRAM_CHAT_ID=your_chat_id_here

# Webhook Secret Token (opsional, amma tövsiyə olunur)
# @BotFather-dan /setprivacy -> Secret Token ilə yarada bilərsiniz
TELEGRAM_WEBHOOK_SECRET=

# Cavab veriləcək icazə verilən Chat ID-lər (vergül ilə ayrılır)
# Bu ID-lər botdan komanda istifadə edə bilər
# TELEGRAM_CHAT_ID avtomatik olaraq bu siyahıya əlavə olunur
ALLOWED_CHAT_IDS=

# ===== GROQ AI =====
# https://console.groq.com → API Keys → Create API Key (PULSUZDUR!)
GROQ_API_KEY=your_groq_api_key_here

# ===== OPENROUTER (_opsional, ehtiyat modeli üçün) =====
# https://openrouter.ai → Keys
OPENROUTER_API_KEY=

# ===== SCHEDULER =====
# Neçə saatdan bir tarasın (default: 6)
SCAN_INTERVAL_HOURS=6

# ===== FİLTR =====
# Minimum əhəmiyyət balı 1-10 (default: 6) — altındakılar göndərilməz
MIN_IMPORTANCE_SCORE=6

# Hər taramada maksimum neçə xəbər emal edilsin (API qənaəti üçün)
MAX_ARTICLES_PER_RUN=40

# ===== AUTH =====
# /scan endpoint üçün API key (opsional, boş qoysanız auth yoxdur)
SCAN_API_KEY=
